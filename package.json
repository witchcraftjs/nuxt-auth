{
	"name": "@witchcraft/nuxt-auth",
	"version": "0.6.0-beta.2",
	"description": "Nuxt module for logging.",
	"repository": "witchcraftjs/nuxt-auth",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@11.5.0",
	"//exports": {
		"require in ./*": "Temporary for drizzle."
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		},
		"./*": {
			"types": "./dist/runtime/*.d.ts",
			"import": "./dist/runtime/*.js",
			"require": "./dist/runtime/*.js"
		},
		"./electron": {
			"types": "./dist/runtime/electron/index.d.ts",
			"import": "./dist/runtime/electron/index.js"
		},
		"./electron/*": {
			"types": "./dist/runtime/electron/*.d.ts",
			"import": "./dist/runtime/electron/*.js"
		},
		"./electron/preload": {
			"types": "./dist/runtime/electron/preload/index.d.ts",
			"import": "./dist/runtime/electron/preload/index.js"
		},
		"./electron/main": {
			"types": "./dist/runtime/electron/main/index.d.ts",
			"import": "./dist/runtime/electron/main/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "husky && pnpm build",
		"build": "cross-env-shell DISABLE_POSTGRES_ENSURE_ENV=true 'nuxt-module-build prepare && nuxt-module-build build && pnpm nuxi build playground'",
		"build:only": "nuxt-module-build build",
		"//": "drizzle requires we run from playground",
		"dev:playground": "pnpm test:server",
		"dev:prepare": "cross-env-shell DISABLE_POSTGRES_ENSURE_ENV=true 'pnpm nuxt-module-build build --stub && pnpm nuxt-module-build prepare && pnpm nuxi prepare playground'",
		"lint": "pnpm lint:eslint && pnpm lint:types && pnpm lint:commits",
		"lint:eslint": "eslint \"{src,playground/app,playground/app-electron,playground/test}/**/*.{ts,vue}\" \"*.{js,cjs,mjs,ts}\" \"playground/*.{js,cjs,mjs,ts}\"",
		"lint:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p tsconfig.test.json",
		"lint:commits": "commitlint --from-last-tag --to HEAD --verbose",
		"lint:fix": "pnpm lint:eslint --fix && pnpm lint:types",
		"test": "pnpm --dir playground test",
		"test:unit": "pnpm --dir playground test:unit",
		"test:unit+server": "pnpm --dir playground test:unit+server",
		"test:ci": "pnpm --dir playground test:ci",
		"test:e2e": "pnpm --dir playground test:e2e",
		"test:e2e:full": "pnpm --dir playground test:e2e:full",
		"test:electron:build": "pnpm --dir playground test:electron:build",
		"test:electron": "pnpm --dir playground test:electron",
		"test:server": "pnpm --dir playground test:server",
		"test:dev": "pnpm --dir playground test:dev"
	},
	"peerDependencies": {
		"drizzle-orm": "catalog:"
	},
	"@comments": {
		"dependencies": {
			"@witchcraft/nuxt-logger": "This is only for some types for the logger, but is otherwise unused."
		}
	},
	"dependencies": {
		"@alanscodelog/tsconfigs": "catalog:",
		"@alanscodelog/utils": "catalog:",
		"@iconify/json": "catalog:",
		"@nuxt/kit": "catalog:",
		"@oslojs/encoding": "catalog:",
		"@standard-schema/spec": "catalog:",
		"@vueuse/core": "catalog:",
		"@witchcraft/nuxt-logger": "catalog:",
		"@witchcraft/nuxt-utils": "catalog:",
		"@witchcraft/ui": "catalog:",
		"better-auth": "catalog:",
		"@better-auth/electron": "catalog:",
		"cookie-es": "catalog:",
		"defu": "catalog:",
		"drizzle-zod": "catalog:",
		"h3": "catalog:",
		"nuxt-security": "catalog:",
		"pino-pretty": "catalog:",
		"unplugin-icons": "catalog:",
		"unplugin-vue-components": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@alanscodelog/eslint-config": "catalog:",
		"@alanscodelog/semantic-release-config": "catalog:",
		"@commitlint/cli": "catalog:",
		"@nuxt/eslint-config": "catalog:",
		"@nuxt/module-builder": "catalog:",
		"@nuxt/schema": "catalog:",
		"@playwright/test": "catalog:",
		"@tailwindcss/cli": "catalog:",
		"@types/node": "latest",
		"changelogen": "catalog:",
		"concurrently": "catalog:",
		"cross-env": "catalog:",
		"drizzle-orm": "catalog:",
		"electron": "catalog:",
		"eslint": "catalog:",
		"husky": "catalog:",
		"nuxt": "catalog:",
		"playwright-core": "catalog:",
		"reka-ui": "catalog:",
		"semantic-release": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"unimport": "catalog:",
		"vue": "catalog:",
		"vue-tsc": "catalog:"
	},
	"release": {
		"extends": [
			"@alanscodelog/semantic-release-config"
		]
	},
	"commitlint": {
		"extends": [
			"@alanscodelog"
		]
	},
	"publishConfig": {
		"access": "public"
	}
}
